<Window x:Class="UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:converters="clr-namespace:UI.Converters"
        xmlns:validation="clr-namespace:ScriptApi.Validation;assembly=ScriptApi"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900">
    <Window.Resources>
        <converters:ValidationSeverityToColorConverter x:Key="SeverityToColor"/>
    </Window.Resources>

    <DockPanel>

        <!-- ── Toolbar ──────────────────────────────────────────────────── -->
        <ToolBar DockPanel.Dock="Top" Padding="4">

            <Button Content="▶ Run"
                    Command="{Binding RunCommand}"
                    Padding="8,4" Margin="0,0,4,0"/>

            <Button Content="■ Abort"
                    Command="{Binding AbortCommand}"
                    Padding="8,4" Margin="0,0,8,0"/>

            <Separator/>

            <Button Content="New"
                    Command="{Binding NewScriptCommand}"
                    Padding="8,4" Margin="4,0"/>

            <Button Content="Open"
                    Command="{Binding OpenScriptCommand}"
                    Padding="8,4" Margin="0,0,4,0"/>

            <Button Content="Save"
                    Command="{Binding SaveScriptCommand}"
                    Padding="8,4" Margin="0,0,4,0"/>

            <Button Content="Save As"
                    Command="{Binding SaveScriptAsCommand}"
                    Padding="8,4" Margin="0,0,8,0"/>

            <Separator/>

            <!-- Progress -->
            <TextBlock Text="{Binding ProgressText}"
                       VerticalAlignment="Center"
                       Margin="8,0" MinWidth="200"/>

            <ProgressBar Value="{Binding ProgressPercent}"
                         Minimum="0" Maximum="100"
                         Width="150" Height="16"
                         Margin="4,0"/>

            <Separator/>

            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Margin="8,0"/>
        </ToolBar>

        <!-- ── Validation panel ─────────────────────────────────────────── -->
        <ItemsControl DockPanel.Dock="Bottom"
                      ItemsSource="{Binding ValidationMessages}"
                      MaxHeight="120"
                      Background="#1E1E1E">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type validation:ValidationMessage}">
                    <TextBlock Padding="8,2"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{Binding Severity,
                                   Converter={StaticResource SeverityToColor}}"
                               Text="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── Main content ─────────────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Script editor -->
            <avalonEdit:TextEditor
                Grid.Column="0"
                x:Name="ScriptEditor"
                FontFamily="Consolas"
                FontSize="13"
                SyntaxHighlighting="C#"
                ShowLineNumbers="True"
                WordWrap="False"/>
            <!--Background="#1E1E1E"
                Foreground="#D4D4D4"/>-->

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="#3E3E3E"/>

            <!-- Preview image -->
            <Border Grid.Column="2"
                    Background="#1E1E1E">
                <Viewbox Stretch="Uniform">
                    <Image Source="{Binding PreviewBitmap}"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Viewbox>
            </Border>

        </Grid>
    </DockPanel>
</Window>
