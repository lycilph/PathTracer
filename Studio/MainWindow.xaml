<Window x:Class="Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Studio"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainViewModel, IsDesignTimeCreatable=True}"
        Title="Path Tracer" Height="800" Width="1200">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Render view -->
        <Border Grid.Column="0" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,12,0">
            <Grid>
                <Image Source="{Binding RenderImage}" Stretch="Uniform" />
            </Grid>
        </Border>

        <!-- Right panel -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Controls -->
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
                <TextBlock Text="Render Controls" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Left" Content="Start" Width="100" Margin="0,0,8,0" Command="{Binding StartRenderCommand}"/>
                    <Button DockPanel.Dock="Left" Content="Stop" Width="100" Margin="0,0,8,0" Command="{Binding StartRenderCancelCommand}"/>
                    <ProgressBar IsIndeterminate="{Binding ProgressIndeterminate}" Value="{Binding ProgressPercentage}"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Left" Content="Run SPPM" Width="100" Margin="0,0,8,0" Command="{Binding StartSppmRenderCommand}"/>
                    <Button DockPanel.Dock="Left" Content="Stop SPPM" Width="100" Margin="0,0,8,0" Command="{Binding StartSppmRenderCancelCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Resolution" Width="80" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding WidthInput}" Width="80" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding HeightInput}" Width="80"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Target SPP" Width="80" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TargetSppInput}" Width="80" Margin="0,0,8,0"/>
                    <TextBlock Text="(0 = infinite)" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Tile Size" Width="80" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TileSizeInput}" Width="80" Margin="0,0,8,0"/>
                    <TextBlock Text="Threads" Width="60" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ThreadsInput}" Width="80"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="View" Width="80" VerticalAlignment="Center"/>
                    <ComboBox Width="220"
                              ItemsSource="{Binding DebugBufferNames}"
                              SelectedItem="{Binding SelectedDebugBuffer, Mode=TwoWay}" />
                </StackPanel>

                <Expander Header="SPPM Settings" IsExpanded="True" Margin="0,0,0,12">
                    <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0">
                        <StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Photons/pass" Width="110" VerticalAlignment="Center"/>
                                <TextBox Width="140"
             Text="{Binding Sppm.PhotonsPerPass, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Photon max depth" Width="110" VerticalAlignment="Center"/>
                                <TextBox Width="140"
             Text="{Binding Sppm.PhotonMaxDepth, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Future toggles/inputs (safe to keep visible or comment out for now) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Alpha" Width="110" VerticalAlignment="Center"/>
                                <TextBox Width="140"
             Text="{Binding Sppm.Alpha, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Initial radius" Width="110" VerticalAlignment="Center"/>
                                <TextBox Width="140"
             Text="{Binding Sppm.InitialRadius, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Max iterations" Width="110" VerticalAlignment="Center"/>
                                <TextBox Width="140"
             Text="{Binding Sppm.MaxIterations, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="0 = infinite" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Expander>

            </StackPanel>


            <!-- Stats -->
            <Border Grid.Row="1" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Statistics" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding StatsText}" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Scene script -->
            <Border Grid.Row="2" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Scene Script" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <local:SceneScriptEditor 
                        x:Name="ScriptEditor"
                        Text="{Binding SceneScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Diagnostics="{Binding ScriptDiagnostics}"
                        GoToDiagnosticCommand="{Binding GoToDiagnosticCommand}" />
                </DockPanel>
            </Border>

            <!-- Footer -->
            <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</Window>