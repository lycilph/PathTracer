v -0.3 -0.4 -0.3
v -0.3 -1.0  0.3
v  0.3 -1.0  0.3
v  0.3 -0.4  0.3
v -0.3 -0.4  0.3

# Front face
f 1 2 3
f 1 3 4
# Back face
f 6 5 8
f 6 8 7
# Left face
f 5 1 4
f 5 4 8
# Right face
